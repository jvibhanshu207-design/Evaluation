# LearnSphere Environment Configuration Template
# Copy this file to .env.local to configure custom credentials.
# Do NOT commit real API keys or secrets to version control.

# Translation Provider API (Optional)
# If provided, LearnSphere will route dynamic translations through Google Cloud Translation API.
# If omitted, LearnSphere utilizes the built-in resilient translation service and client-side translation caching.
VITE_TRANSLATION_API_KEY=your_google_cloud_translation_api_key_here

# Custom Translation Proxy URL (Optional)
# e.g., https://api.yourdomain.com/v1/translate
VITE_TRANSLATION_API_URL=

# Application Mode
VITE_APP_ENV=development
